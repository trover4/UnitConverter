@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<form method="get" action="/Conversions">
    <div>
        <label for="conversionType" class="form-label">Convert</label>
        <select id="conversionType"
                name="Conversion.ConversionType"
                class="form-select">
            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">@conversion.Value</option>
            }
        </select>
        <div>
            <label for="input" class="form-label">Value</label>
            <input id="input"
                   name="Conversion.Input"
                   type="text"
                   class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>

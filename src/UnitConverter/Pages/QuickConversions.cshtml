@page
@using UnitConverter.Models
@model UnitConverter.Pages.QuickConversions

@{
    ViewData["Title"] = "Quick Conversions";
}

<h1>Quick Conversions</h1>

@if (Model.Output.HasValue)
{
    <div class="alert alert-success" role="status">Result: @Model.Output</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<h2>Miles to Kilometers</h2>
<form method="get" asp-page-handler="@ConversionTypes.MilesToKilometers">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.MilesToKilometers" />
    <label for="miles" class="form-label">Miles</label>
    <input id="miles"
           name="input"
           type="text"
           class="form-control"/>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Kilometers to Miles</h2>
<form method="get" asp-page-handler="@ConversionTypes.KilometersToMiles">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.KilometersToMiles" />
    <label for="kilometers" class="form-label">Kilometers</label>
    <input id="kilometers"
           name="input"
           type="number"
           step="any"
           class="form-control"/>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Fahrenheit to Celsius</h2>
<form method="get" asp-page-handler="@ConversionTypes.FahrenheitToCelsius">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.FahrenheitToCelsius" />
    <label for="fahrenheit" class="form-label">Fahrenheit</label>
    <textarea id="fahrenheit"
           name="input"
           rows="2"
           class="form-control"></textarea>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Celsius to Fahrenheit</h2>
<form method="get" asp-page-handler="@ConversionTypes.CelsiusToFahrenheit">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.CelsiusToFahrenheit" />
    <label for="celsius" class="form-label">
        Celsius (-100 to 100)
    </label>
    <input id="celsius"
           name="input"
           type="range"
           min="-100"
           max="100"
           step="1"
           value="0"
           class="form-range"
           />

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Pounds to Kilograms</h2>
<form method="get" asp-page-handler="@ConversionTypes.PoundsToKilograms">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.PoundsToKilograms" />
    <label for="pounds" class="form-label">Pounds</label>
    <select id="pounds"
            name="input"
            asp-items="Model.PoundOptions"
            class="form-select">
    </select>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Kilograms to Pounds</h2>
<form method="get" asp-page-handler="@ConversionTypes.KilogramsToPounds">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.KilogramsToPounds" />

    <label for="kilograms" class="form-label">Kilograms</label>
    <input id="kilograms"
           name="input"
           type="number"
           step="any"
           class="form-control"/>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>MPH to Mach</h2>
<form method="get" asp-page-handler="@ConversionTypes.MphToMach">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.MphToMach" />
    <label for="mph" class="form-label">Miles per Hour</label>
    <input id="mph"
           name="input"
           type="number"
           step="any"
           class="form-control"/>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<h2>Mach to MPH</h2>
<form method="get" asp-page-handler="@ConversionTypes.MachToMph">
    <input type="hidden"
           name="handler"
           value="@ConversionTypes.MachToMph" />
    <label for="mach" class="form-label">Mach</label>
    <input id="mach"
           name="input"
           type="number"
           step="any"
           class="form-control"/>

    <button type="submit" class="btn btn-primary">
        Convert
    </button>
</form>

<a asp-page="/Index">Back to Home Page</a>
